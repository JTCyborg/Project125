 164+ 01D1              ; CMD_LOAD_X86
 165+ 01D1              ; 1) Keep default WIN1 page #03 selected; logical $5000 maps to $00D000.
 166+ 01D1              ; 2) Select ZX DMA module and set physical DMA target $00D000.
 167+ 01D1              ; 3) Enable DMA by setting DMA_CST bit 7.
 168+ 01D1              ; 4) Clear CBIT: this is the READY indication to the host.
 169+ 01D1              ; 5) Wait for host's end marker (#FF written to GSCOM, setting CBIT).
 170+ 01D1              ; 6) Disable DMA, then clear CBIT to acknowledge completion.
 171+ 01D1              ;
 172+ 01D1              ; Host uses OUT/LDIR writes into $0000-$3FFF. No dummy write is performed.
 173+ 01D1              ; -------------------------------------------------------------------------
 174+ 01D1              command_load_x86:
 175+ 01D1                      ; Keep the documented default WIN1 page selected. DMA writes to
 176+ 01D1                      ; physical $00D000, which appears at logical $5000 in page #03.
 177+ 01D1 3E 03                ld      a, #03
