   3++8000              ;
   4++8000              ; Project text-console profile: 42 columns x 12 rows, 6x8 glyphs.
   5++8000              ; Implemented functions:
   6++8000              ;   AH=00h set mode 03h (project 42x12 text profile)
   7++8000              ;   AH=0Fh get mode (AL=03h, AH=42, BH=0)
   8++8000              ;   AH=02h set cursor (BH=0, DH=row, DL=column)
   9++8000              ;   AH=03h get cursor (DH=row, DL=column)
  10++8000              ;   AH=0Eh teletype output (AL=character, BH=0)
  11++8000              ;
  12++8000              ; INT 10h enters through the normal IVT/stack frame. The BIOS service itself
  13++8000              ; is a firmware trap, then returns through the normal IRET primitive.
  14++8000              ; Host stream protocol over DBIT/GSDAT:
  15++8000              ;   nonzero byte = teletype character
  16++8000              ;   00 00        = clear the lower debug console
  17++8000              ;   00 01 row col= set lower debug console cursor
  18++8000              ; =========================================================================
