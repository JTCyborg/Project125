   1++15D8              ; =========================================================================
   2++15D8              ; PROJECT 124 — 8086 real-mode interrupt frame engine (Stage 2A)
   3++15D8              ;
   4++15D8              ; Implements the architectural memory/stack part of software INT and IRET.
   5++15D8              ; This module is deliberately separate from the legacy four-opcode fetch
   6++15D8              ; loop: opcode dispatch and execution of guest handler code are Stage 2B.
   7++15D8              ;
   8++15D8              ; x86_int_enter:
   9++15D8              ;   IN: A = interrupt vector number
  10++15D8              ;   Uses x86_reg_{ss,sp,cs,ip,flags}.
  11++15D8              ;   Push order: FLAGS, CS, IP; final SP points to saved IP.
  12++15D8              ;   Loads new IP:CS from IVT[vector], clears IF and TF.
  13++15D8              ;   OUT: carry clear on success, carry set on memory error.
  14++15D8              ;
  15++15D8              ; x86_iret_return:
  16++15D8              ;   Pops IP, CS, FLAGS; restores all three and advances SP by six.
  17++15D8              ;
  18++15D8              ; x86_int_self_test:
  19++15D8              ;   Installs a temporary vector 20h, validates the exact stack frame,
  20++15D8              ;   validates IF/TF clearing, executes IRET, validates restored state,
  21++15D8              ;   and removes the temporary vector.
  22++15D8              ;   Success: status=0, AX=1A01h. Failure: status=8, AX=1Axxh.
  23++15D8              ; =========================================================================
