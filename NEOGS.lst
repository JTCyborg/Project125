   1++0FE8              ; =========================================================================
   2++0FE8              ; PROJECT 125 — BIOS ROM integration and low-memory foundation
   3++0FE8              ;
   4++0FE8              ; Establishes the guest-visible low-memory data layout and initial BIOS ROM
   5++0FE8              ; integration path. The selected 8 KiB ROM is loaded into NeoGS page 75,
   6++0FE8              ; mapped at FE000h-FFFFFh, and exposed read-only by x86_memory.asm.
   7++0FE8              ; The actual BIOS services remain guest x86 code and are not yet emulated.
   8++0FE8              ;
   9++0FE8              ; Target PC memory profile:
  10++0FE8              ;   00000-003FF  IVT (256 entries, 4 bytes each)
  11++0FE8              ;   00400-004FF  BIOS Data Area (BDA)
  12++0FE8              ;   00500-9FFFF  conventional RAM profile (640 KiB)
  13++0FE8              ;   A0000-BFFFF  video-memory window (ATM presenter/device decode pending)
  14++0FE8              ;   C0000-FDFFF  option-ROM/device window (device decode pending)
  15++0FE8              ;   FE000-FFFFF  selected 8 KiB BIOS ROM (read-only overlay)
  16++0FE8              ;
  17++0FE8              ; Bring-up limitation: x86_memory.asm currently maps 00000h-FDFFFh as writable
  18++0FE8              ; guest RAM and overlays only FE000h-FFFFFh as ROM. Video/option-ROM subregions
  19++0FE8              ; are reserved in the architecture but are not yet decoded as devices.
  20++0FE8              ;
  21++0FE8              ; Entry: bios_post
  22++0FE8              ; Success: x86_exit_status=0, saved_x86_ax=#B105
  23++0FE8              ; Failure: x86_exit_status=7, saved_x86_ax=#B1xx
  24++0FE8              ; NeoGS DMA receive command is implemented in main.asm; ATM host sender is
  25++0FE8              ; implemented in zx_main/bios_transfer.asm but TR-DOS integration is pending.
  26++0FE8              ; =========================================================================
