 357  628E              ; Z80-originated log output: timestamp state is updated only here.
 358  628E              ; The raw emitter is shared with NeoGS, but NeoGS bytes never get RTC prefixes.
 359  628E              p125_emit_char:
 360  628E CD 9E 62             call    p125_emit_raw_char
 361  6291 FE 0D                cp      13
 362  6293 28 03                jr      z, .p125_mark_line_start
 363  6295 FE 0A                cp      10
 364  6297 C0                   ret     nz
 365  6298              .p125_mark_line_start:
 366  6298 3E 01                ld      a, 1
 367  629A 32 C8 67             ld      (p125_log_line_start), a
 368  629D C9                   ret
 369  629E
 370  629E              ; Raw byte output to port #EF and the ATM-native screen. Does not touch
 371  629E              ; the Z80 log-line timestamp state; NeoGS debug bytes use this path.
 372  629E              p125_emit_raw_char:
 373  629E F5                   push    af
 374  629F C5                   push    bc
 375  62A0 01 EF 00             ld      bc, #00EF
 376  62A3 ED 79                out     (c), a
 377  62A5 CD B7 A1             call    BIOS_DebugConsole_PrintChar
 378  62A8 C1                   pop     bc
 379  62A9 F1                   pop     af
 380  62AA C9                   ret
