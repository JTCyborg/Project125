   1  0000              ; =========================================================================
   2  0000              ; PROJECT 125 — minimal ATM Turbo 2+ host application
   3  0000              ;
   4  0000              ; Boot sequence:
   5  0000              ;   1. TR-DOS BASIC loads this host program at 6000h.
   6  0000              ;   2. Host streams neoprog.C to NeoGS and starts the Project125 firmware.
   7  0000              ;   3. Host reads BIOS.C from TR-DOS sector-by-sector and streams it to page 75.
   8  0000              ;   4. NeoGS validates the ROM header/reset vector.
   9  0000              ;   5. Host commands the 8086 executor to start at FFFF:0000.
  10  0000              ;   6. NeoGS debug stream is mirrored to ATM/emulator port EFh; result frame
  11  0000              ;      reports x86 status and AX.
  12  0000              ;
  13  0000              ; Disk files produced by this source:
  14  0000              ;   boot.B, proj125.C, neoprog.C, BIOS.C
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      INCLUDE "../shared/video_frame.inc"
