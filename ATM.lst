 516  E195              ; -------------------------------------------------------------------------
 517  E195              ; BIOS.C, NEOLOAD.C and NEOFW.C are independent TR-DOS files.
 518  E195              ; The complete 8 KiB BIOS is never staged in the host program's resident RAM.
 519  E195              ; -------------------------------------------------------------------------
 520  E195                      PAGE 1
 521  E195                      ORG #C000
 522  C000              p125_bios_image_start:
 523  C000                      INCBIN "bios/BIOS.BIN"
 524  E000              p125_bios_image_end:
 525  E000                      ASSERT p125_bios_image_end - p125_bios_image_start = #2000
 526  E000                      SAVETRD "disk_A.trd", "BIOS.C", #C000, #2000
 527  E000
 528  E000                      INCLUDE "neogs_files.inc"
# file opened: neogs_files.inc
   1+ E000              NEOLOAD_FILE_SIZE EQU #02A5
   2+ E000              NEOFW_FILE_SIZE EQU #6CEF
   3+ E000              NEOFW_RESIDENT_SIZE EQU #2C82
   4+ E000              NEOFW_BANK68_SIZE EQU #3AEB
   5+ E000              NEOFW_BANK69_SIZE EQU #0572
   6+ E000
# file closed: neogs_files.inc
 529  E000                      ASSERT NEOLOAD_FILE_SIZE >= 1
 530  E000                      ASSERT NEOLOAD_FILE_SIZE <= #0800
 531  E000                      ASSERT NEOFW_FILE_SIZE >= 1
 532  E000                      ASSERT NEOFW_FILE_SIZE <= #C010
 533  E000
 534  E000                      PAGE 1
 535  E000                      ORG #C000
 536  C000              p125_neoload_start:
 537  C000                      INCBIN "zx_main/neoload.bin"
 538  C2A5              p125_neoload_end:
 539  C2A5                      ASSERT p125_neoload_end - p125_neoload_start = NEOLOAD_FILE_SIZE
 540  C2A5                      SAVETRD "disk_A.trd", "NEOLOAD.C", #C000, NEOLOAD_FILE_SIZE
 541  C2A5
 542  C2A5              ; SAVETRD reads from a single 16-KiB mapped RAM page. The 48-KiB
 543  C2A5              ; package is therefore staged in up to three physical pages and appended
 544  C2A5              ; sector-aligned to one NEOFW.C directory entry. V1 host streaming sees one
 545  C2A5              ; ordinary sequential file and needs no knowledge of the disk-side chunks.
 546  C2A5                      IF NEOFW_FILE_SIZE > #4000
 547  C2A5              NEOFW_CHUNK0_SIZE EQU #4000
 548  C2A5                      ELSE
 549  C2A5 ~            NEOFW_CHUNK0_SIZE EQU NEOFW_FILE_SIZE
 550  C2A5                      ENDIF
 551  C2A5
 552  C2A5                      PAGE 3
 553  C2A5                      ORG #C000
 554  C000              p125_neofw_chunk0_start:
 555  C000                      INCBIN "zx_main/neofw.bin", 0, NEOFW_CHUNK0_SIZE
 556  0000              p125_neofw_chunk0_end:
 557  0000                      ASSERT p125_neofw_chunk0_end - p125_neofw_chunk0_start = NEOFW_CHUNK0_SIZE
 558  0000                      SAVETRD "disk_A.trd",|"NEOFW.C",#C000,NEOFW_CHUNK0_SIZE
 559  0000
 560  0000                      IF NEOFW_FILE_SIZE > #4000
 561  0000                              IF NEOFW_FILE_SIZE > #8000
 562  0000 ~            NEOFW_CHUNK1_SIZE EQU #4000
 563  0000                              ELSE
 564  0000              NEOFW_CHUNK1_SIZE EQU NEOFW_FILE_SIZE - #4000
 565  0000                              ENDIF
 566  0000                              PAGE 1
 567  0000                              ORG #C000
 568  C000              p125_neofw_chunk1_start:
 569  C000                              INCBIN "zx_main/neofw.bin", #4000, NEOFW_CHUNK1_SIZE
