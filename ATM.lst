 416  62EB 3A CD 67             ld      a, (txt_sec)
 417  62EE CD 9E 62             call    p125_emit_raw_char
 418  62F1 3A CE 67             ld      a, (txt_sec+1)
 419  62F4 CD 9E 62             call    p125_emit_raw_char
 420  62F7 3E 5D                ld      a, ']'
 421  62F9 CD 9E 62             call    p125_emit_raw_char
 422  62FC 3E 20                ld      a, ' '
 423  62FE CD 9E 62             call    p125_emit_raw_char
