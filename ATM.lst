 491  7AA3                      INCLUDE "bios_transfer.asm"
# file opened: bios_transfer.asm
   1+ 7AA3              ; =========================================================================
   2+ 7AA3              ; PROJECT 125 — ATM host-side BIOS DMA stream sender
   3+ 7AA3              ;
   4+ 7AA3              ; This module sends the selected 8 KiB BIOS image to NeoGS page 75.
   5+ 7AA3              ; The caller is responsible for reading BIOS.BIN from TR-DOS in 256-byte
   6+ 7AA3              ; sectors into a reusable buffer (normally #C000) and calling
   7+ 7AA3              ; neogs_bios_transfer_sector once for each sector.
   8+ 7AA3              ;
   9+ 7AA3              ; Transfer contract:
  10+ 7AA3              ;   1. neogs_bios_transfer_start sends CMD_LOAD_BIOS and waits for CBIT=0.
  11+ 7AA3              ;   2. Caller reads exactly 32 sectors (256 bytes each).
  12+ 7AA3              ;   3. Each sector is copied with LDIR to host address 0000h..00FFh.
  13+ 7AA3              ;      The NeoGS ZX DMA engine writes the stream to physical 12C000h.
  14+ 7AA3              ;   4. neogs_bios_transfer_finish sends the #FF end marker and waits for
  15+ 7AA3              ;      NeoGS to disable DMA and clear CBIT.
  16+ 7AA3              ;
  17+ 7AA3              ; Entry requirements:
  18+ 7AA3              ;   - Project125 custom NeoGS firmware is already running.
  19+ 7AA3              ;   - HL points to the current 256-byte sector buffer for sector routine.
  20+ 7AA3              ;   - The sector buffer must not overlap the active host stack.
  21+ 7AA3              ;   - Caller keeps interrupts disabled while the DMA transfer is active.
  22+ 7AA3              ;
  23+ 7AA3              ; This file deliberately does not implement TR-DOS directory lookup or
  24+ 7AA3              ; sector reading. That is the next host integration step.
  25+ 7AA3              ; =========================================================================
  26+ 7AA3
  27+ 7AA3              BIOS_HOST_SECTOR_SIZE      EQU #0100
  28+ 7AA3              BIOS_HOST_SECTOR_COUNT     EQU 32
  29+ 7AA3              BIOS_HOST_DMA_WINDOW       EQU #0000
  30+ 7AA3              BIOS_HOST_WAIT_LIMIT       EQU #FFFF
  31+ 7AA3
  32+ 7AA3              ; Start NeoGS page-75 DMA receive.
  33+ 7AA3              ; OUT: carry clear when NeoGS has cleared CBIT and is ready for data.
  34+ 7AA3              neogs_bios_transfer_start:
  35+ 7AA3 3E 20                ld      a, BIOS_HOST_SECTOR_COUNT
  36+ 7AA5 32 FC 7E             ld      (bios_host_sectors_left), a
  37+ 7AA8 AF                   xor     a
  38+ 7AA9 32 FE 7E             ld      (bios_host_transfer_error), a
  39+ 7AAC
  40+ 7AAC 3E 0C                ld      a, CMD_LOAD_BIOS
  41+ 7AAE D3 BB                out     (GSCOM), a
  42+ 7AB0
  43+ 7AB0 01 FF FF             ld      bc, BIOS_HOST_WAIT_LIMIT
  44+ 7AB3              .bios_start_wait:
  45+ 7AB3 DB BB                in      a, (GSSTAT)
  46+ 7AB5 CB 47                bit     B_CBIT, a
  47+ 7AB7 28 0C                jr      z, .bios_start_ready
  48+ 7AB9 0B                   dec     bc
  49+ 7ABA 78                   ld      a, b
  50+ 7ABB B1                   or      c
  51+ 7ABC 20 F5                jr      nz, .bios_start_wait
  52+ 7ABE
  53+ 7ABE 3E 01                ld      a, 1
  54+ 7AC0 32 FE 7E             ld      (bios_host_transfer_error), a
  55+ 7AC3 37                   scf
  56+ 7AC4 C9                   ret
  57+ 7AC5
  58+ 7AC5              .bios_start_ready:
  59+ 7AC5 B7                   or      a
  60+ 7AC6 C9                   ret
  61+ 7AC7
  62+ 7AC7              ; Send one complete 256-byte TR-DOS sector.
  63+ 7AC7              ; IN: HL = address of the sector buffer.
  64+ 7AC7              ; OUT: carry clear if accepted locally; carry set if more than 32 sectors sent.
  65+ 7AC7              ; The source buffer is not preserved by LDIR; the caller refills it next.
  66+ 7AC7              neogs_bios_transfer_sector:
  67+ 7AC7 3A FC 7E             ld      a, (bios_host_sectors_left)
  68+ 7ACA B7                   or      a
  69+ 7ACB 20 07                jr      nz, .bios_sector_available
  70+ 7ACD
  71+ 7ACD 3E 02                ld      a, 2
  72+ 7ACF 32 FE 7E             ld      (bios_host_transfer_error), a
  73+ 7AD2 37                   scf
  74+ 7AD3 C9                   ret
  75+ 7AD4
  76+ 7AD4              .bios_sector_available:
  77+ 7AD4 11 00 00             ld      de, BIOS_HOST_DMA_WINDOW
  78+ 7AD7 01 00 01             ld      bc, BIOS_HOST_SECTOR_SIZE
  79+ 7ADA F3                   di
  80+ 7ADB ED B0                ldir
  81+ 7ADD
  82+ 7ADD 3A FC 7E             ld      a, (bios_host_sectors_left)
  83+ 7AE0 3D                   dec     a
  84+ 7AE1 32 FC 7E             ld      (bios_host_sectors_left), a
  85+ 7AE4 B7                   or      a
  86+ 7AE5 C9                   ret
  87+ 7AE6
  88+ 7AE6              ; Finish the stream and retrieve the transfer acknowledgement; BIOS contents are not inspected.
  89+ 7AE6              ; OUT: carry clear only if exactly 32 sectors were sent and NeoGS acknowledged.
  90+ 7AE6              neogs_bios_transfer_finish:
  91+ 7AE6 3A FC 7E             ld      a, (bios_host_sectors_left)
  92+ 7AE9 32 FD 7E             ld      (bios_host_missing_sectors), a
  93+ 7AEC
  94+ 7AEC                      ; The marker is a command write, never a DMA payload byte.
  95+ 7AEC 3E FF                ld      a, #FF
  96+ 7AEE D3 BB                out     (GSCOM), a
  97+ 7AF0
  98+ 7AF0                      ; NeoGS returns five raw bytes from page-75 offset 1FF0 through DBIT.
  99+ 7AF0                      ; Drain them here, before waiting for CBIT=0, to avoid blocking NeoGS.
 100+ 7AF0 CD C3 7B             call    neogs_bios_transfer_read_tail_dump
 101+ 7AF3
