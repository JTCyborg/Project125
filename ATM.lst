   7+ 7F63              ;   Length: 8192 bytes
   8+ 7F63              ;   Sectors: 32
   9+ 7F63              ;
  10+ 7F63              ; BIOS.C is staged in host RAM at #C000..#DFFF before DMA starts. The complete
  11+ 7F63              ; disk-read phase and DMA-send phase are deliberately kept separate.
  12+ 7F63              ;
  13+ 7F63              ; Include order in the host program:
  14+ 7F63              ;   shared/neogs_io.inc
