 272  622D
 273  622D              ; Z80 logs are RTC-timestamped; NeoGS stream is raw; screen is ATM-native 80x25.
 274  622D              ; Minimal diagnostic channel: port #EF only. It deliberately bypasses RTC,
 275  622D              ; the ATM screen renderer and the normal log path, so it can report where
 276  622D              ; startup stops even when one of those subsystems is the cause.
 277  622D              p125_trace_port:
 278  622D F5                   push    af
 279  622E C5                   push    bc
 280  622F E5                   push    hl
 281  6230 01 EF 00             ld      bc, #00EF
 282  6233              .p125_trace_loop:
 283  6233 7E                   ld      a, (hl)
 284  6234 23                   inc     hl
 285  6235 B7                   or      a
 286  6236 28 04                jr      z, .p125_trace_done
 287  6238 ED 79                out     (c), a
 288  623A 18 F7                jr      .p125_trace_loop
 289  623C              .p125_trace_done:
 290  623C E1                   pop     hl
 291  623D C1                   pop     bc
 292  623E F1                   pop     af
 293  623F C9                   ret
 294  6240
 295  6240              ; Raw hexadecimal output for failures that can occur before the ATM UI exists.
 296  6240              p125_trace_hex8:
 297  6240 F5                   push    af
 298  6241 0F                   rrca
 299  6242 0F                   rrca
 300  6243 0F                   rrca
 301  6244 0F                   rrca
 302  6245 CD 4E 62             call    p125_trace_hex_nibble
 303  6248 F1                   pop     af
 304  6249 E6 0F                and     #0F
 305  624B C3 4E 62             jp      p125_trace_hex_nibble
 306  624E
 307  624E              p125_trace_hex_nibble:
 308  624E E6 0F                and     #0F
 309  6250 C6 30                add     a, '0'
 310  6252 FE 3A                cp      '9' + 1
 311  6254 38 02                jr      c, .trace_hex_digit
 312  6256 C6 07                add     a, 7
 313  6258              .trace_hex_digit:
 314  6258 D3 EF                out     (#EF), a
 315  625A C9                   ret
 316  625B
 317  625B              p125_trace_newline:
 318  625B 3E 0D                ld      a, 13
 319  625D D3 EF                out     (#EF), a
 320  625F 3E 0A                ld      a, 10
 321  6261 D3 EF                out     (#EF), a
 322  6263 C9                   ret
