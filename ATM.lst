 136+ 6D72              ; Read Status D/A/B through the currently selected backend.
 137+ 6D72              DS12887_READ_STATUS:
 138+ 6D72 3E 0D                ld      a, #0D
 139+ 6D74 CD E7 6D             call    DS12887_READ_REG
 140+ 6D77 32 DC 6E             ld      (ds12887_status_d), a
 141+ 6D7A 3E 0A                ld      a, #0A
 142+ 6D7C CD E7 6D             call    DS12887_READ_REG
 143+ 6D7F 32 DA 6E             ld      (ds12887_status_a), a
 144+ 6D82 3E 0B                ld      a, #0B
 145+ 6D84 CD E7 6D             call    DS12887_READ_REG
 146+ 6D87 32 DB 6E             ld      (ds12887_status_b), a
 147+ 6D8A C9                   ret
 148+ 6D8B
 149+ 6D8B              ; Print the last captured Status D/A/B triplet.
 150+ 6D8B              DS12887_PRINT_STATUS:
 151+ 6D8B 3A DC 6E             ld      a, (ds12887_status_d)
 152+ 6D8E CD B4 6E             call    DS12887_PRINT_HEX8
 153+ 6D91 3E 20                ld      a, ' '
 154+ 6D93 CD CF 6E             call    DS12887_PRINT_CHAR
 155+ 6D96 3A DA 6E             ld      a, (ds12887_status_a)
 156+ 6D99 CD B4 6E             call    DS12887_PRINT_HEX8
 157+ 6D9C 3E 20                ld      a, ' '
 158+ 6D9E CD CF 6E             call    DS12887_PRINT_CHAR
 159+ 6DA1 3A DB 6E             ld      a, (ds12887_status_b)
 160+ 6DA4 C3 B4 6E             jp      DS12887_PRINT_HEX8
