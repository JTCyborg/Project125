 725+ 7F20              .dma_reverse_ready:
 726+ 7F20                      ; NeoGS ZX DMA documentation: the first ROM-window read is a
 727+ 7F20                      ; pipeline/dummy byte. It starts the DMA read cycle but is invalid.
 728+ 7F20                      ; The NEXT read returns the byte at the programmed HAD/MAD/LAD address.
 729+ 7F20                      ; Keep the dummy read separate from the 256-byte payload.
 730+ 7F20 21 00 00             ld      hl, 0
 731+ 7F23 F3                   di
 732+ 7F24 7E                   ld      a, (hl)                 ; mandatory dummy read; discard result
