 384  62AE B7                   or      a
 385  62AF C8                   ret     z
 386  62B0 CD B8 62             call    p125_print_timestamp
 387  62B3 AF                   xor     a
 388  62B4 32 C8 67             ld      (p125_log_line_start), a
 389  62B7 C9                   ret
