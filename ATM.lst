# file opened: ds12887_rtc.asm
   1+ 6CC8              ; =========================================================================
   2+ 6CC8              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3+ 6CC8              ; Version: D1.07
   4+ 6CC8              ;
   5+ 6CC8              ; ATM710 dual interface:
   6+ 6CC8              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7+ 6CC8              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8+ 6CC8              ; The RTC data/control registers are never written by this driver.
   9+ 6CC8              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10+ 6CC8              ;
  11+ 6CC8              ; DS12887 registers used:
  12+ 6CC8              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13+ 6CC8              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14+ 6CC8              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15+ 6CC8              ; =========================================================================
  16+ 6CC8
  17+ 6CC8              DS12887_PROBE:
  17+ 6CC8
  18+ 6CC8 F5                   push    af
  19+ 6CC9 C5                   push    bc
  20+ 6CCA D5                   push    de
  21+ 6CCB E5                   push    hl
  22+ 6CCC
  23+ 6CCC                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24+ 6CCC AF                   xor     a
  25+ 6CCD 32 D8 6E             ld      (ds12887_backend), a
  26+ 6CD0 CD BB 6D             call    DS12887_OPEN
  27+ 6CD3 CD 72 6D             call    DS12887_READ_STATUS
  28+ 6CD6                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29+ 6CD6                      ; has Status D exactly 80h and Status A divider bits 010b.
  30+ 6CD6 CD A7 6D             call    DS12887_VALIDATE_STATUS
  31+ 6CD9 30 1C                jr      nc, ds12887_probe_status_ready
  32+ 6CDB
  33+ 6CDB                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34+ 6CDB                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35+ 6CDB CD D6 6D             call    DS12887_CLOSE
  36+ 6CDE 3E 01                ld      a, 1
  37+ 6CE0 32 D8 6E             ld      (ds12887_backend), a
  38+ 6CE3 CD BB 6D             call    DS12887_OPEN
  39+ 6CE6 CD 72 6D             call    DS12887_READ_STATUS
  40+ 6CE9                      ; Read back the SMUC system port after selecting address mode.
  41+ 6CE9                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42+ 6CE9                      ; an FF readback therefore identifies a closed DOS-port gate.
  43+ 6CE9 3A D8 6E             ld      a, (ds12887_backend)
  44+ 6CEC B7                   or      a
  45+ 6CED 28 08                jr      z, ds12887_probe_status_ready
  46+ 6CEF                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47+ 6CEF                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48+ 6CEF                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49+ 6CEF                      ; this is a useful decoder-presence test.
  50+ 6CEF 01 BE 5F             ld      bc, #5FBE
  51+ 6CF2 ED 78                in      a, (c)
  52+ 6CF4 32 D9 6E             ld      (ds12887_smuc_control), a
  53+ 6CF7
  54+ 6CF7              ds12887_probe_status_ready:
  55+ 6CF7 CD A7 6D             call    DS12887_VALIDATE_STATUS
  56+ 6CFA DA 0B 6D             jp      c, ds12887_probe_invalid
  57+ 6CFD
  58+ 6CFD 3E 01                ld      a, 1
  59+ 6CFF 32 D7 6E             ld      (ds12887_available), a
  60+ 6D02
  61+ 6D02 CD 06 6E             call    DS12887_READ_SNAPSHOT
  62+ 6D05 DA 12 6D             jp      c, ds12887_probe_read_error
  63+ 6D08
  64+ 6D08 C3 16 6D             jp      ds12887_probe_done
  65+ 6D0B
  66+ 6D0B              ds12887_probe_invalid:
  67+ 6D0B AF                   xor     a
  68+ 6D0C 32 D7 6E             ld      (ds12887_available), a
  69+ 6D0F C3 16 6D             jp      ds12887_probe_done
  70+ 6D12
  71+ 6D12              ds12887_probe_read_error:
  72+ 6D12 AF                   xor     a
  73+ 6D13 32 D7 6E             ld      (ds12887_available), a
  74+ 6D16
  75+ 6D16              ds12887_probe_done:
  76+ 6D16 CD D6 6D             call    DS12887_CLOSE
  77+ 6D19 E1                   pop     hl
  78+ 6D1A D1                   pop     de
  79+ 6D1B C1                   pop     bc
  80+ 6D1C F1                   pop     af
  81+ 6D1D C9                   ret
