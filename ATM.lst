 177+ 6DBB              ; -------------------------------------------------------------------------
 178+ 6DBB              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179+ 6DBB              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180+ 6DBB              ; -------------------------------------------------------------------------
 181+ 6DBB              DS12887_OPEN:
 182+ 6DBB F5                   push    af
 183+ 6DBC C5                   push    bc
 184+ 6DBD 3A D8 6E             ld      a, (ds12887_backend)
 185+ 6DC0 B7                   or      a
 186+ 6DC1 20 09                jr      nz, ds12887_open_smuc
 187+ 6DC3 01 F7 EF             ld      bc, #EFF7
 188+ 6DC6 3E 80                ld      a, #80
 189+ 6DC8 ED 79                out     (c), a
 190+ 6DCA 18 07                jr      ds12887_open_done
 191+ 6DCC              ds12887_open_smuc:
 192+ 6DCC                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193+ 6DCC                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194+ 6DCC                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195+ 6DCC                      ; the SMUC multiplexed ISA address/control configuration and can
 196+ 6DCC                      ; interfere with later TR-DOS disk operations.
 197+ 6DCC 01 BA FF             ld      bc, #FFBA
 198+ 6DCF 3E 71                ld      a, #71
 199+ 6DD1 ED 79                out     (c), a
 200+ 6DD3              ds12887_open_done:
 201+ 6DD3 C1                   pop     bc
 202+ 6DD4 F1                   pop     af
 203+ 6DD5 C9                   ret
 204+ 6DD6
 205+ 6DD6              DS12887_CLOSE:
 206+ 6DD6 F5                   push    af
 207+ 6DD7 C5                   push    bc
 208+ 6DD8 3A D8 6E             ld      a, (ds12887_backend)
 209+ 6DDB B7                   or      a
 210+ 6DDC 20 06                jr      nz, ds12887_close_done
 211+ 6DDE 01 F7 EF             ld      bc, #EFF7
 212+ 6DE1 AF                   xor     a
 213+ 6DE2 ED 79                out     (c), a
 214+ 6DE4              ds12887_close_done:
 215+ 6DE4 C1                   pop     bc
 216+ 6DE5 F1                   pop     af
 217+ 6DE6 C9                   ret
