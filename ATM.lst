 219+ 6DE7              ; -------------------------------------------------------------------------
 220+ 6DE7              ; A = DS12887 register number, returns register value in A.
 221+ 6DE7              ; Caller must have opened the EFF7 CMOS gate.
 222+ 6DE7              ; No writes are made to the selected RTC register.
 223+ 6DE7              ; -------------------------------------------------------------------------
 224+ 6DE7              DS12887_READ_REG:
 225+ 6DE7 C5                   push    bc
 226+ 6DE8 4F                   ld      c, a
 227+ 6DE9 3A D8 6E             ld      a, (ds12887_backend)
 228+ 6DEC B7                   or      a
 229+ 6DED 20 0D                jr      nz, ds12887_read_smuc
 230+ 6DEF 79                   ld      a, c
 231+ 6DF0 01 F7 DF             ld      bc, #DFF7
 232+ 6DF3 ED 79                out     (c), a
 233+ 6DF5 01 F7 BF             ld      bc, #BFF7
 234+ 6DF8 ED 78                in      a, (c)
 235+ 6DFA C1                   pop     bc
 236+ 6DFB C9                   ret
 237+ 6DFC              ds12887_read_smuc:
 238+ 6DFC 79                   ld      a, c
 239+ 6DFD 01 BA DF             ld      bc, #DFBA
 240+ 6E00 ED 79                out     (c), a
 241+ 6E02 ED 78                in      a, (c)
 242+ 6E04 C1                   pop     bc
 243+ 6E05 C9                   ret
