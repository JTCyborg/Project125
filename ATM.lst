 494  810C
 495  810C              ; The ATM presenter must execute from window 2 (#8000-BFFF): during a draw
 496  810C              ; it temporarily maps video pages 7/3 into windows 1/3. The host program at
 497  810C              ; #6000 and the TR-DOS staging page are therefore never overwritten.
 498  810C                      ASSERT $ <= #A000
 499  810C                      ORG #A000
 500  A000                      INCLUDE "p125_screen_console.asm"
# file opened: p125_screen_console.asm
   1+ A000              ; =========================================================================
   2+ A000              ; PROJECT125 — ATM TURBO 2+ native 80x25 text console
   3+ A000              ;
   4+ A000              ; This module is deliberately placed at #A000 in window 2. The host program
   5+ A000              ; is loaded at #6000 in physical page 5; the ATM text screen uses the
   6+ A000              ; alternate screen pair page 7/page 3 selected by bit 3 of port #7FFD.
   7+ A000              ;
   8+ A000              ; The renderer temporarily maps page 7 to #4000 and page 3 to #C000, writes
   9+ A000              ; the character/attribute, then restores page 5/page 0 before returning to
  10+ A000              ; the caller. Code at #6000 and the TR-DOS #C000 staging buffer are preserved.
  11+ A000              ;
  12+ A000              ; Text layout follows the tested Project112 ATM 80x25 renderer:
  13+ A000              ;   offset = #01C0 + row*64 + column/2
  14+ A000              ;   character even: page 7, #4000+offset
  15+ A000              ;   character odd : page 7, #6000+offset
  16+ A000              ;   attribute even: page 3, #E000+offset
  17+ A000              ;   attribute odd : page 3, #C000+offset+1
  18+ A000              ; =========================================================================
  19+ A000
  20+ A000              BIOS_DEBUG_COLUMNS EQU 80
  21+ A000              BIOS_DEBUG_ROWS    EQU 13
  22+ A000              BIOS_DEBUG_TOP     EQU 12
  23+ A000              P125_VIDEO_PAGE7   EQU #78          ; RAM page 7, inverted page number
  24+ A000              P125_VIDEO_PAGE3   EQU #7C          ; RAM page 3, inverted page number
  25+ A000              P125_HOST_PAGE5    EQU #7A          ; RAM page 5, host code at #6000
  26+ A000              P125_HOST_PAGE0    EQU #7F          ; RAM page 0, TR-DOS staging at #C000
  27+ A000
  28+ A000 00           Console_X: db 0
  29+ A001 0C           Console_Y: db BIOS_DEBUG_TOP
  30+ A002
  31+ A002              ; =========================================================================
  32+ A002              ; ATM shadow-port and text-mode initialization.
  33+ A002              ; The TR-DOS ROM trampoline must run before any #7FF7/#FFF7/#0177 access.
  34+ A002              ; =========================================================================
  35+ A002              p125_atm_video_init:
  35+ A002
  36+ A002 F5                   push    af
  37+ A003 C5                   push    bc
  38+ A004 D5                   push    de
  39+ A005 E5                   push    hl
  40+ A006
  41+ A006                      ; Reset the ATM paging/control latch BEFORE enabling permanent
  42+ A006                      ; DOSEN. On this board #EFF7 is part of the ATM paging control path;
  43+ A006                      ; resetting it after the #0177 shadow-port setup can undo the state
  44+ A006                      ; needed by the TR-DOS overlay.
  45+ A006 AF                   xor     a
  46+ A007 01 F7 EF             ld      bc, #EFF7
  47+ A00A ED 79                out     (c), a
  48+ A00C
  49+ A00C                      ; ROM2=1 (D4) is required for TR-DOS overlay; D3 selects alternate
  50+ A00C                      ; video pages 7/3. This is #18, matching the host display setup.
  51+ A00C 3E 18                ld      a, #18
  52+ A00E 01 FD 7F             ld      bc, #7FFD
  53+ A011 ED 79                out     (c), a
  54+ A013 32 3B 5C             ld      (#5C3B), a
  55+ A016
  56+ A016                      ; Open shadow ports and hold DOSEN permanently (A9=0) using the
  57+ A016                      ; documented TR-DOS ROM trampoline. Do this AFTER the paging reset.
  58+ A016 01 26 A0             ld      bc, p125_atm_ports_open_done
  59+ A019 C5                   push    bc
  60+ A01A 01 53 2A             ld      bc, #2A53
  61+ A01D C5                   push    bc
  62+ A01E 01 77 01             ld      bc, #0177
  63+ A021 3E C3                ld      a, #C3
  64+ A023 C3 2F 3D             jp      #3D2F
  65+ A026
  66+ A026              p125_atm_ports_open_done:
  67+ A026                      ; Window 0 must use ROM with D7=1 so its ROM page selection is
  68+ A026                      ; coupled to ROM2/DOSEN. #BF selects the low ROM page with the
  69+ A026                      ; DOSEN-controlled low ROM select: BASIC-48 when DOSEN=0, TR-DOS
  70+ A026                      ; when DOSEN=1. This is the ATM2+ documented auto-TR-DOS mapping.
  71+ A026 3E BF                ld      a, #BF
  72+ A028 01 F7 3F             ld      bc, #3FF7
  73+ A02B ED 79                out     (c), a
  74+ A02D
  75+ A02D
