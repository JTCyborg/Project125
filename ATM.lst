 571  ECEF                              ASSERT p125_neofw_chunk1_end - p125_neofw_chunk1_start = NEOFW_CHUNK1_SIZE
 572  ECEF                              SAVETRD "disk_A.trd",&"NEOFW.C",#C000,NEOFW_CHUNK1_SIZE
 573  ECEF                      ENDIF
 574  ECEF
 575  ECEF                      IF NEOFW_FILE_SIZE > #8000
 576  ECEF ~            NEOFW_CHUNK2_SIZE EQU NEOFW_FILE_SIZE - #8000
 577  ECEF ~                            PAGE 2
 578  ECEF ~                            ORG #C000
 579  ECEF ~            p125_neofw_chunk2_start:
 580  ECEF ~                            INCBIN "zx_main/neofw.bin", #8000, NEOFW_CHUNK2_SIZE
 581  ECEF ~            p125_neofw_chunk2_end:
 582  ECEF ~                            ASSERT p125_neofw_chunk2_end - p125_neofw_chunk2_start = NEOFW_CHUNK2_SIZE
