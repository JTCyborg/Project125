  91+ 6D1F C5                   push    bc
  92+ 6D20 D5                   push    de
  93+ 6D21 E5                   push    hl
  94+ 6D22
  95+ 6D22 CD BB 6D             call    DS12887_OPEN
  96+ 6D25 3A D7 6E             ld      a, (ds12887_available)
  97+ 6D28 B7                   or      a
  98+ 6D29 CA 56 6D             jp      z, ds12887_time_unknown
  99+ 6D2C
 100+ 6D2C CD 06 6E             call    DS12887_READ_SNAPSHOT
 101+ 6D2F DA 56 6D             jp      c, ds12887_time_unknown
 102+ 6D32
 103+ 6D32                      ; Convert the hour according to Status B (12/24-hour and BCD/binary).
 104+ 6D32 CD 4E 6E             call    DS12887_CONVERT_HOUR
 105+ 6D35 21 C9 67             ld      hl, txt_hour
 106+ 6D38 CD 9E 6E             call    DS12887_TO_DECIMAL
 107+ 6D3B
 108+ 6D3B 3A DE 6E             ld      a, (ds12887_minutes)
 109+ 6D3E CD 83 6E             call    DS12887_TO_BINARY
 110+ 6D41 21 CB 67             ld      hl, txt_min
 111+ 6D44 CD 9E 6E             call    DS12887_TO_DECIMAL
 112+ 6D47
 113+ 6D47 3A DD 6E             ld      a, (ds12887_seconds)
 114+ 6D4A CD 83 6E             call    DS12887_TO_BINARY
 115+ 6D4D 21 CD 67             ld      hl, txt_sec
 116+ 6D50 CD 9E 6E             call    DS12887_TO_DECIMAL
 117+ 6D53 C3 6A 6D             jp      ds12887_time_done
 118+ 6D56
 119+ 6D56              ds12887_time_unknown:
 120+ 6D56 3E 3F                ld      a, '?'
 121+ 6D58 32 C9 67             ld      (txt_hour), a
 122+ 6D5B 32 CA 67             ld      (txt_hour+1), a
 123+ 6D5E 32 CB 67             ld      (txt_min), a
 124+ 6D61 32 CC 67             ld      (txt_min+1), a
 125+ 6D64 32 CD 67             ld      (txt_sec), a
 126+ 6D67 32 CE 67             ld      (txt_sec+1), a
 127+ 6D6A
 128+ 6D6A              ds12887_time_done:
 129+ 6D6A CD D6 6D             call    DS12887_CLOSE
 130+ 6D6D E1                   pop     hl
 131+ 6D6E D1                   pop     de
 132+ 6D6F C1                   pop     bc
 133+ 6D70 F1                   pop     af
 134+ 6D71 C9                   ret
