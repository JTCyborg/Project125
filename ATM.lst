 391  62B8              p125_print_timestamp:
 392  62B8                      ; Do not poll or print an unknown RTC timestamp before the DS12887
 393  62B8                      ; probe has completed. This keeps pre-UI startup logs clean.
 394  62B8 3A D7 6E             ld      a, (ds12887_available)
 395  62BB B7                   or      a
 396  62BC C8                   ret     z
